[Unit]
Description=TToken - AI API Gateway Platform
Documentation=https://github.com/txzh007/sub2api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ttoken
Group=ttoken
WorkingDirectory=/opt/ttoken
EnvironmentFile=-/etc/ttoken/ttoken.env
Environment=GIN_MODE=release
ExecStart=/opt/ttoken/sub2api
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ttoken

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/ttoken

[Install]
WantedBy=multi-user.target
